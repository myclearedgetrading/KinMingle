{
  "name": "kinmingle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,live -c cyan,magenta \"next dev -H 0.0.0.0 -p 3000\" \"tsx server/realtime.ts\"",
    "build": "prisma generate && next build",
    "start": "concurrently -n web,live -c cyan,magenta \"next start -H 0.0.0.0 -p 3000\" \"tsx server/realtime.ts\"",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.5.0",
    "jose": "^6.0.11",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
